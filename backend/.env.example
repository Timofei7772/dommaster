# Смета AI - Конфигурация окружения

# База данных PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smeta_ai

# Путь к старой базе Access (для миграции)
LEGACY_ACCESS_DB=C:\Program Files\СК Афина\Смета 2007\db\EstDB.accdb

# API ключи для ИИ (опционально)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# JWT токены
SECRET_KEY=smeta-ai-super-secret-key-change-in-production-2024
